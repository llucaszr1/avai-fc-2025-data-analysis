model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Jogos","Jogadores","participacao_gols","estatisticas_jogador"]

ref table Jogos
ref table Jogadores
ref table participacao_gols
ref table estatisticas_jogador
ref table DIM_Calendario

ref cultureInfo pt-BR

